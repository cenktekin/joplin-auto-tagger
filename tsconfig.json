{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "strict": true,
    "types": [
      "node"
    ],
    "moduleResolution": "node",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "api/*": [
        "./api/*"
      ]
    },
    "allowSyntheticDefaultImports": true,
    // "allowImportingTsExtensions": true,
    "noEmit": false
  },
  "exclude": [
    "node_modules",
    "dist",
    "publish",
    "archive"
  ]
}
